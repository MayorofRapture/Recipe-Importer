# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# Base URL you already use to reach Mealie in your browser.
# Example for a NAS host publishing container port 9000 as 9925:
MEALIE_URL=http://10.0.0.169:9925
MEALIE_TOKEN=REPLACE_WITH_MEALIE_API_TOKEN

# Windows example: C:/Users/YourName/Documents/Recipes
RECIPE_DIR=C:/Recipes_To_Import

GEMINI_MODEL=gemini-3.5-flash-lite
WORKERS=4
GEMINI_RPM=12
