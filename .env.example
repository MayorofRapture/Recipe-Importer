# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# Base URL you already use to reach Mealie in your browser.
# Example for a NAS host publishing container port 9000 as 9925:
MEALIE_URL=http://10.0.0.169:9925
MEALIE_TOKEN=REPLACE_WITH_MEALIE_API_TOKEN
# Leave false unless the installed Mealie recipe import endpoint has been
# verified to preserve an empty recipeInstructions list.
MEALIE_SUPPORTS_EMPTY_INSTRUCTIONS=false

# Windows example: C:/Users/YourName/Documents/Recipes
RECIPE_DIR=C:/Recipes_To_Import

GEMINI_MODEL=gemini-3.5-flash-lite
# Optional Windows OCR executable for RECITATION recovery.
# Example: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
# Optional ordered model routing. IDs are validated with --validate-models.
GEMINI_MODELS_JSON={"models":[{"id":"gemini-3.5-flash-lite","role":"primary","rpm":12,"rpd":0},{"id":"REPLACE_WITH_QUALITY_MODEL","role":"quality_escalation","rpm":6,"rpd":0},{"id":"REPLACE_WITH_FALLBACK_MODEL","role":"quota_fallback","rpm":6,"rpd":0}]}
WORKERS=4
GEMINI_RPM=12
# Optional tag applied only to newly created recipes in a run.
BATCH_TAG=
